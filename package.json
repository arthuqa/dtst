{
  "name": "dtst",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @dtst MCP servers (img, txt)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "node --env-file-if-exists=.env scripts/integration-test.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:packages",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

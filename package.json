{
  "name": "dtst",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the @dtst MCP servers (img, txt)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "node --env-file-if-exists=.env scripts/integration-test.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:packages",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
